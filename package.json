{
  "name": "ziwei-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Zi Wei Dou Shu charting, pattern evidence, classics RAG and grounded AI interpretation platform.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ziwei-ai",
    "test:p1": "tsx --test lib/ziwei-ai/chart-engine/__tests__/*.test.ts",
    "test:p2": "tsx --test lib/ziwei-ai/ui-chart/__tests__/react-iztro-view-model.test.ts",
    "test:p3": "tsx --test lib/ziwei-ai/pattern-engine/__tests__/*.test.ts",
    "test:p4": "tsx --test lib/ziwei-ai/rag/__tests__/*.test.ts",
    "test:p5": "tsx --test lib/ziwei-ai/ai-agent/__tests__/*.test.ts",
    "test:p6": "tsx --test lib/ziwei-ai/critic/__tests__/*.test.ts",
    "test:p7": "tsx --test lib/ziwei-ai/platform/__tests__/platform.test.ts",
    "test:p8": "tsx --test lib/ziwei-ai/platform/__tests__/runtime.test.ts",
    "test:ziwei-ai": "npm run test:p1 && npm run test:p2 && npm run test:p3 && npm run test:p4 && npm run test:p5 && npm run test:p6 && npm run test:p7 && npm run test:p8",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify:release": "npm run typecheck && npm run test:ziwei-ai && npm run build && npm run smoke:production",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "html2canvas": "^1.4.1",
    "iztro": "2.6.0",
    "lunar-javascript": "^1.7.3",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-iztro": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "lint-staged": {
    "*.{ts,tsx,md,mdx}": "node scripts/zh-punct-lint.mjs --fix"
  }
}
