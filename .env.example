# 复制为 .env.local 后填入实际值

# ─── Ziwei AI 服务端 Provider ───
# 浏览器端永远不读取这些变量；不要添加 NEXT_PUBLIC_ 前缀。
# Provider 支持 responses / chat-completions / messages 三种 API 风格。

# 默认 Profile 示例：OpenCode Go + GPT 5.6 Luna
ZIWEI_AI_BASE_URL=https://opencode.ai/zen/go/v1
ZIWEI_AI_API_KEY=your-server-side-api-key
ZIWEI_AI_MODEL=gpt-5.6-luna
# auto 会根据模型自动选择端点；也可显式指定：
# responses | chat-completions | messages
ZIWEI_AI_API_STYLE=auto
# 可选：1000–300000 毫秒，默认 60000。
ZIWEI_AI_TIMEOUT_MS=60000

# ─── P11 运行时多模型 Profile ───
# 可选。配置后，页面可直接选择模型，不需要修改环境变量后重新部署。
# Profile 可省略 baseUrl/apiKeyEnv，从上面的默认 Provider 继承 Base URL 和 API Key。
# 不允许在 JSON 中写 raw apiKey。
ZIWEI_AI_PROFILES_JSON=[{"id":"qwen","label":"Qwen 3.7 Plus","model":"qwen3.7-plus"},{"id":"kimi","label":"Kimi K3","model":"kimi-k3"}]
# 可选；不填时优先使用 legacy/default Profile，否则使用第一个 Profile。
ZIWEI_AI_DEFAULT_PROFILE=default

# 不同 Provider 可通过 apiKeyEnv 引用另一个服务端 Secret，例如：
# OPENAI_RUNTIME_KEY=another-server-side-key
# ZIWEI_AI_PROFILES_JSON=[{"id":"openai","label":"OpenAI Runtime","model":"gpt-runtime","baseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_RUNTIME_KEY","apiStyle":"responses"}]
# 注意：apiKeyEnv 只写环境变量名称；真实 Key 仍必须单独配置在服务端/Vercel Secret 中。

# OpenCode Go 兼容模型示例：
# gpt-5.6-luna       -> responses
# qwen3.7-plus       -> messages
# kimi-k3            -> chat-completions
# 也接受 opencode-go/gpt-5.6-luna；API 调用时会自动去掉 opencode-go/ 前缀。

# 其他 OpenAI-compatible 网关 / 本地 vLLM / Ollama：
# ZIWEI_AI_BASE_URL=http://127.0.0.1:8000/v1
# ZIWEI_AI_API_KEY=local-only
# ZIWEI_AI_MODEL=Qwen3.6-35B-A3B
# ZIWEI_AI_API_STYLE=chat-completions

# ─── P12 生产安全与费用保护 ───
# 紧急总开关。false 时 /api/ziwei-ai/interpret 返回 503，排盘/RAG 等非计费能力不受影响。
ZIWEI_AI_INTERPRET_ENABLED=true
# 每个运行实例最多同时处理多少个真实 AI 解读。默认 2；范围 1–32。
ZIWEI_AI_MAX_INFLIGHT=2
# 每个用户请求最多允许多少次上游模型调用。1=不做 Critic 修订；2=首次 + 最多一次修订。
ZIWEI_AI_MAX_PROVIDER_CALLS=2
# 可选，逗号分隔的浏览器 Origin 白名单；空值表示不启用应用层 Origin 限制。
# 生产示例：https://ziwei-ai-platform.vercel.app
ZIWEI_AI_ALLOWED_ORIGINS=
# 注意：MAX_INFLIGHT 是单实例保护，不是全局限流。Vercel 部署还应在 Firewall 对
# POST /api/ziwei-ai/interpret 配置入口 Rate Limit，优先在函数执行前拦截滥用流量。

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
