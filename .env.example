# 复制为 .env.local 后填入实际值

# ─── Ziwei AI 服务端 Provider（OpenAI 兼容协议）───
# 浏览器端永远不读取这些变量；不要添加 NEXT_PUBLIC_ 前缀。
ZIWEI_AI_BASE_URL=https://api.deepseek.com/v1
ZIWEI_AI_API_KEY=your-server-side-api-key
ZIWEI_AI_MODEL=deepseek-v4-flash
# 可选：1000–300000 毫秒，默认 60000。
ZIWEI_AI_TIMEOUT_MS=60000

# 也可指向 Qwen/Kimi/OpenAI 或本地 vLLM/Ollama 的 OpenAI-compatible endpoint。
# ZIWEI_AI_BASE_URL=http://127.0.0.1:8000/v1
# ZIWEI_AI_API_KEY=local-only
# ZIWEI_AI_MODEL=Qwen3.6-35B-A3B

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
