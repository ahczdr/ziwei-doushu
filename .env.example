# 复制为 .env.local 后填入实际值

# ─── Ziwei AI 服务端 Provider ───
# 浏览器端永远不读取这些变量；不要添加 NEXT_PUBLIC_ 前缀。
# Provider 支持 responses / chat-completions / messages 三种 API 风格。

# 示例：OpenCode Go + GPT 5.6 Luna
ZIWEI_AI_BASE_URL=https://opencode.ai/zen/go/v1
ZIWEI_AI_API_KEY=your-server-side-api-key
ZIWEI_AI_MODEL=gpt-5.6-luna
# auto 会根据 OpenCode Go 模型自动选择端点；也可显式指定：
# responses | chat-completions | messages
ZIWEI_AI_API_STYLE=auto
# 可选：1000–300000 毫秒，默认 60000。
ZIWEI_AI_TIMEOUT_MS=60000

# OpenCode Go 切换示例（只改模型即可，auto 会选择对应协议）：
# ZIWEI_AI_MODEL=kimi-k3
# ZIWEI_AI_MODEL=glm-5.3
# ZIWEI_AI_MODEL=qwen3.7-plus
# ZIWEI_AI_MODEL=deepseek-v4-pro
# 也接受 OpenCode 配置格式，例如 opencode-go/gpt-5.6-luna；API 调用时会自动去掉 opencode-go/ 前缀。

# 其他 OpenAI-compatible 网关 / 本地 vLLM / Ollama：
# ZIWEI_AI_BASE_URL=http://127.0.0.1:8000/v1
# ZIWEI_AI_API_KEY=local-only
# ZIWEI_AI_MODEL=Qwen3.6-35B-A3B
# ZIWEI_AI_API_STYLE=chat-completions

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
