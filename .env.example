# 复制为 .env.local 后填入实际值

# ─── 旧版 AI 推理配置（保留兼容）───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── Ziwei AI P7 服务端 Provider（OpenAI 兼容协议）───
# 浏览器端永远不读取这些变量。
ZIWEI_AI_BASE_URL=https://api.deepseek.com/v1
ZIWEI_AI_API_KEY=your-server-side-api-key
ZIWEI_AI_MODEL=deepseek-chat

# 也可指向 Qwen/Kimi/OpenAI 或本地 vLLM/Ollama 的 OpenAI-compatible endpoint。
# ZIWEI_AI_BASE_URL=http://127.0.0.1:8000/v1
# ZIWEI_AI_API_KEY=local-only
# ZIWEI_AI_MODEL=Qwen3.6-35B-A3B

# ─── 或用其他旧版兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
